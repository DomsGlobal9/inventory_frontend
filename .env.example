# Where this build sends its API calls. Required -- the app refuses to start without it
# (src/lib/config.ts), rather than silently defaulting to a backend that is not yours.
#
# Local:      http://localhost:4006/api/v1
# Production: set in Vercel, not here. Vite bakes VITE_* in at BUILD time, so changing it
#             in Vercel does nothing until the frontend is redeployed.
VITE_API_URL=http://localhost:4006/api/v1
